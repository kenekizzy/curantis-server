generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  CLIENT
  HW
  HS
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

// ============================================================
// MODELS
// ============================================================

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  @@map("health_checks")
}

enum WorkerType {
  HW
  HS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  phone         String?    @unique
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)
  passwordHash  String?
  googleSub     String?    @unique
  role          Role
  status        UserStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  refreshTokens    RefreshToken[]
  clientProfile    ClientProfile?
  workerProfile    WorkerProfile?
  bookingsAsClient Booking[] @relation("ClientBookings")
  bookingsAsWorker Booking[] @relation("WorkerBookings")

  @@index([role, status])
  @@map("users")
}

model ClientProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  fullName          String
  avatarUrl         String?
  state             String
  lga               String
  careRecipientName String?
  careRecipientAge  Int?
  careRecipientRel  String?
  careNeedsSummary  String?  @db.Text
  emergencyName     String?
  emergencyPhone    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

enum CredentialStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model WorkerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  fullName           String
  avatarUrl          String?
  bio                String?            @db.VarChar(500)
  workerType         WorkerType
  yearsExperience    Int?
  institution        String?
  gradYear           Int?
  fieldOfStudy       String?
  hourlyRateKobo     BigInt
  state              String
  lga                String
  languages          String[]           @default([])
  skills             String[]           @default([])
  isAvailable        Boolean            @default(true)
  verificationStatus VerificationStatus @default(PENDING)
  avgRating          Decimal            @default(0.00) @db.Decimal(3, 2)
  reviewCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials        Credential[]
  availabilitySlots  AvailabilitySlot[]
  availabilityBlocks AvailabilityBlock[]

  @@index([state, lga, workerType, verificationStatus, avgRating])
  @@map("worker_profiles")
}

model Verification {
  id         String             @id @default(cuid())
  userId     String
  nin        String?
  idDocUrl   String
  selfieUrl  String
  status     VerificationStatus @default(PENDING)
  adminNote  String?            @db.Text
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status])
  @@index([userId])
  @@map("verifications")
}

model Credential {
  id            String           @id @default(cuid())
  workerId      String
  title         String
  issuingBody   String
  licenceNumber String?
  documentUrl   String
  expiresAt     DateTime?        @db.Date
  status        CredentialStatus @default(PENDING)
  adminNote     String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workerProfile WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model AvailabilitySlot {
  id        String @id @default(cuid())
  workerId  String
  dayOfWeek Int    // 0 = Sunday, 6 = Saturday
  startTime String // "08:00"
  endTime   String // "18:00"

  workerProfile WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("availability_slots")
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  workerId  String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?

  workerProfile WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("availability_blocks")
}

enum BookingStatus {
  PENDING
  ACCEPTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

model ServiceCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  isRestricted Boolean  @default(false) // true = HW only, blocked for HS

  bookings Booking[]

  @@map("service_categories")
}

model Booking {
  id                 String        @id @default(cuid())
  clientId           String
  workerId           String
  categoryId         String
  status             BookingStatus @default(PENDING)
  careAddress        String        @db.Text
  careRequirements   String?       @db.Text
  scheduledStart     DateTime
  scheduledEnd       DateTime
  actualStart        DateTime?
  actualEnd          DateTime?
  durationHours      Decimal       @db.Decimal(5, 2)
  hourlyRateKobo     BigInt
  totalAmountKobo    BigInt
  platformFeeKobo    BigInt
  workerAmountKobo   BigInt
  cancelledBy        String?
  cancellationReason String?       @db.Text
  escrowReleaseAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  client   User            @relation("ClientBookings", fields: [clientId], references: [id])
  worker   User            @relation("WorkerBookings", fields: [workerId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  logs     BookingLog[]
  payment  Payment?
  review   Review?
  reports  Report[]

  @@index([clientId, workerId, status, scheduledStart])
  @@map("bookings")
}

model BookingLog {
  id        String   @id @default(cuid())
  bookingId String
  eventType String
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_logs")
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  REMOVED
}

model Review {
  id            String       @id @default(cuid())
  bookingId     String       @unique
  clientId      String
  workerId      String
  rating        Int
  body          String?      @db.VarChar(500)
  status        ReviewStatus @default(PUBLISHED)
  removedReason String?      @db.Text
  editedAt      DateTime?
  lockedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("reviews")
}

model Report {
  id          String   @id @default(cuid())
  bookingId   String?
  reporterId  String
  accusedId   String
  category    String
  description String   @db.Text
  imageUrls   String[] @default([])
  status      String   @default("OPEN")
  outcome     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("reports")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  PARTIAL_REFUNDED
}

model Payment {
  id          String         @id @default(cuid())
  bookingId   String         @unique
  clientId    String
  amountKobo  BigInt
  currency    String         @default("NGN")
  gateway     PaymentGateway
  gatewayRef  String         @unique
  status      PaymentStatus  @default(PENDING)
  paidAt      DateTime?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  refunds Refund[]

  @@map("payments")
}

model Refund {
  id          String    @id @default(cuid())
  paymentId   String
  amountKobo  BigInt
  reason      String
  status      String    @default("PENDING")
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model BankAccount {
  id            String   @id @default(cuid())
  workerId      String
  bankCode      String
  accountNumber String
  accountName   String
  isDefault     Boolean  @default(false)
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([workerId, accountNumber])
  @@map("bank_accounts")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  deviceHint String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash, userId, expiresAt])
  @@map("refresh_tokens")
}

// ============================================================
// ADMIN
// ============================================================

enum AdminRole {
  SUPER_ADMIN
  VERIFICATION_OFFICER
  SUPPORT_AGENT
  FINANCE_OFFICER
}

model AdminProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  adminRole AdminRole
  createdAt DateTime  @default(now())

  @@map("admin_profiles")
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@map("admin_logs")
}

// ============================================================
// CHAT
// ============================================================

model Conversation {
  id           String    @id @default(cuid())
  bookingId    String?   @unique
  participantA String
  participantB String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages Message[]

  @@index([participantA, participantB])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  text           String?   @db.Text
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  fileType       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}
